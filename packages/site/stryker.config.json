{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/domain/approval.ts",
    "src/lib/domain/limits.ts",
    "src/lib/domain/invisible.ts",
    "src/lib/domain/report.ts",
    "src/lib/domain/privacy.ts",
    "src/lib/domain/handle.ts",
    "src/lib/domain/trending.ts",
    "src/lib/domain/ids.ts",
    "src/lib/domain/expression.ts",
    "src/lib/domain/permissions.ts",
    "src/lib/domain/testimonial.ts",
    "src/lib/domain/moderation.ts",
    "src/lib/domain/social-text.ts",
    "src/lib/domain/social-approval.ts",
    "src/lib/domain/act.ts",
    "src/lib/domain/approval-queue.ts"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "jsonReporter": {
    "fileName": "reports/mutacao.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutacao.html"
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4,
  "timeoutMS": 15000,
  "ignoreStatic": true,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  }
}
