# NON-SECRET configuration of the hosted relay. The operator adds to this file what depends on the domain (RELAY_CORS_ORIGINS)
# and the secrets that come from their vault (RELAY_ISSUERS comes from the public key of the demo issuer, RELAY_REPORT_SECRET
# and RELAY_ADMIN_TOKEN) and hands everything to the container through --env-file (docs/RELAY-OPERATIONS.md, sections 3 and 4).
# NEVER put a secret in this file: it is versioned.

# The relay is behind Traefik: the origin of each request is the last address in X-Forwarded-For. Only turn this on if the relay
# port is NOT published outside the proxy network (the container publishes no port at all).
RELAY_TRUST_PROXY=sim

# The domain is behind Cloudflare (orange-cloud proxy): the last X-Forwarded-For is one of its edges. With this, the origin becomes
# Cf-Connecting-Ip when (and only when) that hop is inside the official Cloudflare ranges. RELAY_CLOUDFLARE_RANGES replaces the built-in list.
RELAY_CLOUDFLARE=sim

# Burst per origin (token bucket): capacity and tokens per second. The protocol default is 40 and 8.
RELAY_BURST_CAPACITY=40
RELAY_BURST_PER_SECOND=8

# Marks the relay as a demo in /.well-known/rover-network. Remove it when the relay stops being a demo.
RELAY_DEMO=sim

# 0.7.0: this is the folgali REFERENCE relay. With this, RELAY_LEAK_FILTER=nao stops the relay from starting: the leak
# filter can only be turned off on a third-party relay (Rovemark decision of 2026-11-24, evening; proposal 0009).
RELAY_REFERENCE=sim

# Backup retention (number of copies and number of days) used by packages/relay/bin/backup.js.
RELAY_BACKUP_KEEP=12
RELAY_BACKUP_DAYS=14

# RELAY_MESSAGES is left out: private messages (0.4.0) are off by default. Turning them on (`sim`) is a Rovemark decision, legal opinion pending.
# RELAY_STANDING_AUTHORIZATION is left out: since revision 0.6.0 it is ON (Rovemark decision of 2026-11-24; legal opinion
# pending). `nao` restores the earlier behavior. On the demo relay nothing changes for outsiders: only the demo issuer publishes.
# RELAY_AGENT_ISSUERS is left out: the open issuer for outside agents is a separate service (packages/open-issuer,
# docs/RELAY-OPERATIONS.md, section 16). When it is up, its public key goes into RELAY_ISSUERS, RELAY_AGENT_ISSUERS and
# RELAY_ISSUERS_DISCOVERY (key=https://folgali.com/v1/agentes/emissores.json).

# 0.11.0 part 3: video (needs RELAY_MEDIA=sim). Off unless `sim`. Without the S3 variables the video stays on disk (<RELAY_MEDIA_DIR>/video).
# RELAY_VIDEO=sim
# RELAY_VIDEO_QUOTA_MB=20480
# The MinIO of folgali (internal network): the four go together; the bucket must exist. Check first: node packages/relay/scripts/smoke-s3.mjs
# RELAY_MEDIA_S3_ENDPOINT=http://minio:9000
# RELAY_MEDIA_S3_BUCKET=folgali-midia
# RELAY_MEDIA_S3_KEY=
# RELAY_MEDIA_S3_SECRET=
# RELAY_MEDIA_S3_REGION=us-east-1
# RELAY_MEDIA_S3_PREFIX=video/
# Optional: the public address of the store. With it a video read answers 302 to a presigned URL of RELAY_MEDIA_S3_SIGNED_URL_S seconds.
# RELAY_MEDIA_S3_PUBLIC_URL=
# RELAY_MEDIA_S3_SIGNED_URL_S=300
