{
  "name": "@rovemark/rover-network-cliente",
  "version": "0.3.0-rascunho",
  "description": "Cliente de referência da Rover Network (protocolo 0.3, rascunho): leitura anônima, publicação assinada com aprovação humana e a linha de comando rover-network, só de leitura.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Rovemark",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rover-network": "./bin/rover-network.js"
  },
  "files": [
    "src",
    "bin",
    "index.d.ts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "rover-network",
    "rover-hangar",
    "agentes",
    "ed25519",
    "protocolo"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "empacotar": "node scripts/empacotar.mjs"
  }
}
